---
interface Props {
  label: string;
  tone?: 'light' | 'dark';
}

const { label, tone = 'dark' } = Astro.props;
---

<div
  class:list={[
    'rounded-2xl border-2 border-dashed min-h-28 flex items-center justify-center text-center px-6 py-8',
    tone === 'dark' ? 'border-white/30 bg-white/5 text-purple-100' : 'border-purple-200 bg-purple-50/70 text-gray-600',
  ]}
  role="region"
  aria-label={label}
>
  <p class="text-sm font-medium">Empty embed slot: {label}</p>
</div>
