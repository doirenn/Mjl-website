---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmbedSlot from '../components/EmbedSlot.astro';
import {
  day,
  immersionAnnouncement,
  immersionApply,
  immersionCtas,
  immersionFooter,
  immersionHero,
  immersionSeo,
  legal,
  plans,
  portalIntro,
  proof,
  receive,
  sound,
  who,
} from '../data/the-immersion';
---

<BaseLayout title={immersionSeo.title} description={immersionSeo.description} ogImage={immersionSeo.ogImage} ogAlt={immersionSeo.ogAlt} announcement={immersionAnnouncement} headerCtas={immersionCtas} footer={immersionFooter}>
  <section class="relative min-h-[70vh] flex items-end overflow-hidden">
    <img src={immersionHero.image.src} alt={immersionHero.image.alt} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-deepPurple via-brand-deepPurple/55 to-brand-deepPurple/20"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4 py-20 text-white space-y-5">
      <p class="text-xs uppercase tracking-[0.25em] text-brand-sunsetPeach font-bold">{immersionHero.kicker}</p>
      <h1 class="font-serif text-5xl sm:text-6xl font-bold">{immersionHero.title}</h1>
      <p class="text-lg text-purple-100 max-w-3xl">{immersionHero.body}</p>
      <p class="text-sm text-purple-100">{immersionHero.where}</p>
      <div class="flex flex-wrap gap-3">
        <a href="#apply" class="px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-sunsetPeach text-brand-deepPurple">Placeholder: claim your immersion</a>
        <a href="#what-you-receive" class="px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider border border-white/40">Explore The Full VIP Experience</a>
      </div>
      <ul class="flex flex-wrap gap-4 text-xs font-semibold">{immersionHero.proofs.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 space-y-4">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-sunsetPeach">{portalIntro.eyebrow}</p>
      <h2 class="font-serif text-4xl font-bold text-brand-deepPurple">{portalIntro.title}</h2>
      <p class="font-serif text-xl italic text-brand-amethyst">"{portalIntro.quote}"</p>
      {portalIntro.paragraphs.map((paragraph) => <p class="text-gray-700 leading-relaxed">{paragraph}</p>)}
      <div class="grid md:grid-cols-3 gap-4 pt-4">
        {portalIntro.points.map((point) => (
          <div class="p-4 rounded-2xl bg-[#faf6ff] border border-purple-100">
            <h3 class="font-serif font-bold text-brand-deepPurple">{point.title}</h3>
            <p class="text-xs text-gray-600 mt-2">{point.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sunset-gradient">
    <div class="max-w-4xl mx-auto px-4 grid md:grid-cols-2 gap-8 items-center">
      <img src={sound.image.src} alt={sound.image.alt} class="rounded-3xl h-80 w-full object-cover border-4 border-white shadow-xl" />
      <div class="space-y-3">
        <p class="font-serif italic text-brand-amethyst text-xl">"{sound.quote}"</p>
        <h2 class="font-serif text-2xl font-bold text-brand-deepPurple">{sound.title}</h2>
        <p class="text-xs text-gray-600">{sound.meta}</p>
        <EmbedSlot label={sound.embedLabel} tone="light" />
        <p class="text-sm text-gray-700">"{sound.caption}"</p>
      </div>
    </div>
  </section>

  <section id="what-you-receive" class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 space-y-4">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-sunsetPeach">{receive.eyebrow}</p>
      <h2 class="font-serif text-4xl font-bold text-brand-deepPurple">{receive.title}</h2>
      <p class="text-gray-600">{receive.intro}</p>
      <div class="spiritual-gradient text-white rounded-3xl p-8 space-y-3">
        <h3 class="font-serif text-2xl font-bold">{receive.coreTitle}</h3>
        <p class="text-brand-gold text-sm font-semibold">{receive.coreSubtitle}</p>
        <p class="text-sm text-purple-100">{receive.coreBody}</p>
      </div>
      <ul class="space-y-2 text-sm text-gray-700">
        {receive.points.map((point) => <li class="flex gap-2"><i class="fa-solid fa-check text-brand-sunsetPeach mt-1"></i><span>{point}</span></li>)}
      </ul>
    </div>
  </section>

  <section id="day" class="py-20 bg-[#faf6ff]">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-serif text-4xl font-bold text-brand-deepPurple mb-8">A Day Inside The Portal</h2>
      <ol class="space-y-4">
        {day.map((item) => (
          <li class="glass-card p-5 rounded-2xl border border-purple-100">
            <p class="text-xs font-bold uppercase tracking-wider text-brand-sunsetPeach">{item.time}</p>
            <h3 class="font-serif text-xl font-bold text-brand-deepPurple">{item.title}</h3>
            <p class="text-sm text-gray-600 mt-1">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="font-serif text-4xl font-bold text-brand-deepPurple mb-3">Who This Is For</h2>
      <p class="text-gray-600 mb-8">The Immersion is an intimate, high-stakes energetic undertaking. It is not designed for casual curiosity; it is reserved for souls standing at the edge of a colossal leap.</p>
      <div class="grid md:grid-cols-3 gap-6">
        {who.map((item) => (
          <article class="p-6 rounded-3xl border border-purple-100 bg-[#faf6ff]">
            <h3 class="font-serif font-bold text-brand-deepPurple">{item.title}</h3>
            <p class="text-sm text-gray-600 mt-2">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="pricing" class="py-20 sunset-gradient">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-serif text-4xl font-bold text-brand-deepPurple text-center">Investment & Flexible Payment Options</h2>
      <p class="text-center text-gray-700 mt-3 mb-4">Choose the payment structure aligned with your financial sovereignty. All options include the complete Immersion continuum.</p>
      <p class="text-center text-sm font-semibold text-brand-deepPurple mb-8">Placeholder: no checkout is connected. These buttons do not take payment.</p>
      <div class="grid lg:grid-cols-3 gap-6">
        {plans.map((plan) => (
          <article class="glass-card rounded-3xl p-6 border border-white shadow-lg flex flex-col">
            <h3 class="font-serif text-2xl font-bold text-brand-deepPurple">{plan.name}</h3>
            <p class="font-serif text-4xl font-bold text-brand-deepPurple mt-2">{plan.price}</p>
            <p class="text-xs font-bold text-brand-sunsetPeach">{plan.detail}</p>
            <p class="text-sm text-gray-600 mt-3 flex-1">{plan.body}</p>
            {plan.bonus && <p class="text-xs font-semibold text-brand-amethyst mt-3">{plan.bonus}</p>}
            <a href="#apply" class="mt-6 block text-center py-3 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-deepPurple text-white">{plan.cta}</a>
          </article>
        ))}
      </div>
      <ul class="mt-8 space-y-2 text-xs text-gray-700 max-w-3xl mx-auto">
        {legal.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-8 items-center">
      <img src={proof.image.src} alt={proof.image.alt} class="rounded-3xl h-96 w-full object-cover" />
      <div>
        <p class="font-serif text-2xl text-brand-deepPurple">"{proof.quote}"</p>
        <p class="text-sm text-gray-600 mt-4 italic">"{proof.body}"</p>
        <p class="text-xs font-bold text-brand-deepPurple mt-4">{proof.name}</p>
        <p class="text-[11px] text-gray-500">{proof.detail} · {proof.note}</p>
      </div>
    </div>
  </section>

  <section id="apply" class="py-20 bg-[#faf6ff]">
    <div class="max-w-3xl mx-auto px-4 glass-card rounded-3xl p-8 border border-purple-100 space-y-4">
      <h2 class="font-serif text-3xl font-bold text-brand-deepPurple">{immersionApply.title}</h2>
      <p class="text-sm text-gray-600">{immersionApply.body}</p>
      <p class="text-xs font-semibold text-brand-sunsetPeach">{immersionApply.note}</p>
      <label class="text-xs font-semibold">Preferred Location Format</label>
      <select disabled class="w-full px-3 py-2 rounded-xl border text-xs">{immersionApply.locations.map((item) => <option>{item}</option>)}</select>
      <label class="text-xs font-semibold">Target Timing</label>
      <select disabled class="w-full px-3 py-2 rounded-xl border text-xs">{immersionApply.timing.map((item) => <option>{item}</option>)}</select>
      <label class="text-xs font-semibold">Preferred Investment Alignment</label>
      <select disabled class="w-full px-3 py-2 rounded-xl border text-xs">{immersionApply.investments.map((item) => <option>{item}</option>)}</select>
      <button type="button" disabled class="w-full py-3 rounded-full text-xs font-bold uppercase bg-brand-deepPurple text-white opacity-70 cursor-not-allowed">{immersionApply.button}</button>
      <p class="text-[11px] text-center text-gray-500">{immersionApply.footnote}</p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 spiritual-gradient rounded-3xl p-8 text-white flex flex-col md:flex-row justify-between gap-6 items-center">
      <div>
        <h2 class="font-serif text-3xl font-bold">Looking for Self-Guided Mastery?</h2>
        <p class="text-sm text-purple-100 mt-2">If an in-person immersion isn't aligned right now, step into the Manifesting Miracles Academy.</p>
      </div>
      <a href="/academy" class="px-8 py-4 rounded-full text-xs font-bold uppercase bg-brand-sunsetPeach text-brand-deepPurple">Join The Academy Today</a>
    </div>
  </section>
</BaseLayout>
