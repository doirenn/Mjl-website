---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  discovery,
  explain,
  shareForm,
  storiesCtas,
  storiesFooter,
  storiesSeo,
  storyFaqs,
  storyFilters,
  storyItems,
  storyStats,
} from '../data/success-stories';
---

<BaseLayout title={storiesSeo.title} description={storiesSeo.description} announcement={null} headerCtas={storiesCtas} footer={storiesFooter}>
  <section class="py-20 sunset-gradient">
    <div class="max-w-5xl mx-auto px-4 text-center space-y-4">
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-brand-sunsetPeach">Real</p>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-brand-deepPurple">Manifestation Success Stories</h1>
      <p class="text-gray-700 max-w-3xl mx-auto">Personal transformation narratives from real souls who dissolved trauma, anchored in sovereignty, and stepped into their dream reality.</p>
    </div>
    <div class="max-w-5xl mx-auto px-4 mt-10 grid md:grid-cols-3 gap-4">
      {storyStats.map((stat) => (
        <div class="glass-card p-6 rounded-3xl text-center">
          <p class="font-serif text-4xl font-bold text-brand-deepPurple">{stat.value}</p>
          <p class="font-semibold text-sm">{stat.label}</p>
          <p class="text-xs text-gray-600 mt-1">{stat.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="stories" class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-serif text-4xl font-bold text-brand-deepPurple text-center">Transformations</h2>
      <p class="text-center text-gray-600 mt-2 mb-6">Explore real stories categorized by the specific energetic breakthrough our clients claimed.</p>
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {storyFilters.map((filter, index) => (
          <button type="button" data-story-filter={filter.id} class:list={['px-4 py-2 rounded-full text-xs font-bold', index === 0 ? 'bg-brand-deepPurple text-white' : 'bg-white border border-purple-200 text-gray-700']}>{filter.label}</button>
        ))}
      </div>
      <p class="text-center text-xs text-gray-500 mb-6">Showing 6 stories from the sample. 5.0 Star Average is the sample's label.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {storyItems.map((story) => (
          <article class="story-card glass-card p-6 rounded-3xl border border-purple-100" data-category={story.category}>
            <p class="text-[11px] font-bold uppercase tracking-wider text-brand-sunsetPeach">{story.tag} · {story.badge}</p>
            <h3 class="font-serif text-2xl font-bold text-brand-deepPurple mt-2">{story.title}</h3>
            <p class="text-[11px] text-gray-500 mt-1">{story.who}</p>
            <p class="text-sm text-gray-700 mt-3">"{story.quote}"</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="share" class="py-16 bg-[#faf6ff]">
    <div class="max-w-3xl mx-auto px-4 glass-card rounded-3xl p-8 space-y-3">
      <h2 class="font-serif text-3xl font-bold text-brand-deepPurple">{shareForm.title}</h2>
      <p class="text-sm text-gray-600">{shareForm.intro}</p>
      <p class="text-xs font-semibold text-brand-sunsetPeach">{shareForm.note}</p>
      <label class="text-xs font-semibold">Pillar of Transformation</label>
      <select disabled class="w-full px-3 py-2 rounded-xl border text-xs">{shareForm.pillars.map((item) => <option>{item}</option>)}</select>
      <button type="button" disabled class="w-full py-3 rounded-full text-xs font-bold uppercase bg-brand-deepPurple text-white opacity-70 cursor-not-allowed">{shareForm.button}</button>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-serif text-3xl font-bold text-brand-deepPurple">{discovery.title}</h2>
      <p class="text-gray-600 mt-2">{discovery.body}</p>
      <ul class="mt-4 text-sm text-gray-700 space-y-1">{discovery.points.map((item) => <li>{item}</li>)}</ul>
      <div class="mt-6 p-5 rounded-2xl border border-dashed border-purple-300 bg-purple-50">
        <p class="text-sm font-semibold text-brand-deepPurple">{discovery.note}</p>
        <p class="text-xs text-gray-600 mt-2">Sample label: 15-Min Free Discovery Call, Zoom, October 2026, Oct 22: {discovery.slots.join(', ')}.</p>
        <button type="button" disabled class="mt-4 px-6 py-3 rounded-full text-xs font-bold uppercase bg-brand-deepPurple text-white opacity-70 cursor-not-allowed">{discovery.button}</button>
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#faf6ff]">
    <div class="max-w-4xl mx-auto px-4 space-y-3">
      <h2 class="font-serif text-3xl font-bold text-brand-deepPurple">{explain.title}</h2>
      {explain.points.map((point) => <p class="text-sm text-gray-700">{point}</p>)}
      <p class="text-sm text-gray-700">{explain.closer}</p>
      <h3 class="font-serif text-2xl font-bold text-brand-deepPurple pt-6">Frequently Asked Questions</h3>
      {storyFaqs.map((item) => (
        <details class="bg-white rounded-2xl border border-purple-100 p-4">
          <summary class="font-semibold cursor-pointer">{item.q}</summary>
          <p class="text-sm text-gray-600 mt-2">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 spiritual-gradient rounded-3xl p-8 text-white flex flex-col md:flex-row justify-between gap-6 items-center">
      <div>
        <p class="text-xs uppercase text-brand-sunsetPeach font-bold">First 14 Days Free</p>
        <h2 class="font-serif text-3xl font-bold">Ready to Write Your Own Success Story?</h2>
      </div>
      <a href="#placeholder" class="px-8 py-4 rounded-full text-xs font-bold uppercase bg-brand-sunsetPeach text-brand-deepPurple">Placeholder: academy trial</a>
    </div>
  </section>
</BaseLayout>

<script>
  let active = 'all';
  document.querySelectorAll('[data-story-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      active = button.getAttribute('data-story-filter') ?? 'all';
      document.querySelectorAll('[data-story-filter]').forEach((item) => {
        item.className = 'px-4 py-2 rounded-full text-xs font-bold bg-white border border-purple-200 text-gray-700';
      });
      button.className = 'px-4 py-2 rounded-full text-xs font-bold bg-brand-deepPurple text-white';
      document.querySelectorAll('.story-card').forEach((card) => {
        const categories = card.getAttribute('data-category') ?? '';
        const match = active === 'all' || categories.split(' ').includes(active);
        card.classList.toggle('hidden', !match);
      });
    });
  });
</script>
