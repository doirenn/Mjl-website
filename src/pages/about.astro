---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmbedSlot from '../components/EmbedSlot.astro';
import {
  aboutAnnouncement,
  aboutBooking,
  aboutClose,
  aboutCtas,
  aboutFooter,
  aboutHero,
  aboutSeo,
  aboutStats,
  offerings,
  pillars,
  praise,
  story,
} from '../data/about';
---

<BaseLayout
  title={aboutSeo.title}
  description={aboutSeo.description}
  ogImage={aboutSeo.ogImage}
  ogAlt={aboutSeo.ogAlt}
  announcement={aboutAnnouncement}
  headerCtas={aboutCtas}
  footer={aboutFooter}
>
  <section class="relative pt-12 pb-20 lg:pt-20 lg:pb-28 overflow-hidden sunset-gradient">
    <div class="aurora-glow w-96 h-96 bg-brand-sunsetPeach top-0 -left-12"></div>
    <div class="aurora-glow w-[32rem] h-[32rem] bg-purple-300 bottom-0 right-0"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-72 sm:w-88 group">
            <div class="absolute -inset-3 rounded-full bg-gradient-to-tr from-brand-sunsetPeach via-brand-gold to-brand-amethyst blur-xl opacity-60 group-hover:opacity-80 transition duration-700 animate-pulse"></div>
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-white p-2">
              <div class="relative rounded-2xl overflow-hidden h-96 sm:h-[460px]">
                <img src={aboutHero.image.src} alt={aboutHero.image.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-deepPurple/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-4 right-4 glass-card p-4 rounded-2xl shadow-lg border border-white/60 text-left">
                  <p class="font-serif font-bold text-brand-deepPurple text-sm sm:text-base">"{aboutHero.quote}"</p>
                  <p class="text-[11px] text-gray-600 mt-0.5">{aboutHero.quoteDetail}</p>
                </div>
              </div>
            </div>
            <div class="absolute -bottom-5 -right-5 glass-card px-4 py-2.5 rounded-2xl shadow-xl border border-white/80 hidden sm:flex items-center space-x-2.5 animate-float">
              <div class="w-9 h-9 rounded-full bg-brand-sunsetPeach text-brand-deepPurple flex items-center justify-center font-bold text-base shadow">
                <i class="fa-solid fa-hands-holding-sparkles"></i>
              </div>
              <div class="text-left">
                <p class="text-[10px] uppercase font-bold text-gray-500">{aboutHero.badgeLabel}</p>
                <p class="text-xs font-bold text-brand-deepPurple">{aboutHero.badgeValue}</p>
              </div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/70 backdrop-blur-md border border-brand-sunsetPeach/40 text-xs font-semibold text-brand-deepPurple shadow-sm">
            <i class="fa-solid fa-crown text-brand-sunsetPeach"></i>
            <span>{aboutHero.eyebrow}</span>
          </div>
          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-deepPurple leading-[1.15] tracking-tight">
            {aboutHero.titleLead} <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-brand-amethyst to-brand-sunsetPeach">{aboutHero.titleName}</span>.
          </h1>
          <p class="font-serif text-xl sm:text-2xl text-brand-amethyst font-semibold italic leading-snug">"{aboutHero.promise}"</p>
          <p class="text-base text-gray-700 leading-relaxed font-normal">{aboutHero.body}</p>
          <div class="glass-card p-4 rounded-2xl border border-purple-200/80 shadow-md space-y-3">
            <div class="text-left">
              <p class="text-xs font-bold text-brand-deepPurple">{aboutHero.audioTitle}</p>
              <p class="text-[11px] text-gray-500">{aboutHero.audioDetail}</p>
            </div>
            <EmbedSlot label={aboutHero.embedLabel} tone="light" />
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            <a href={aboutHero.primary.href} class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-deepPurple text-white hover:bg-brand-amethyst shadow-lg hover:shadow-xl transition-all duration-300">
              {aboutHero.primary.label} <i class="fa-solid fa-arrow-down ml-2 text-brand-sunsetPeach"></i>
            </a>
            <a href={aboutHero.secondary.href} data-open-booking data-program="VIP 1:1 Mentorship" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider text-brand-deepPurple bg-white/80 hover:bg-white border border-purple-200/60 shadow-md transition-all">
              {aboutHero.secondary.label}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-white border-y border-purple-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {aboutStats.map((stat) => (
          <div class="p-4 rounded-2xl bg-[#fdfbfd] border border-purple-100">
            <span class="block font-serif text-3xl sm:text-4xl font-bold text-brand-deepPurple">{stat.value}</span>
            <span class="text-xs uppercase tracking-wider font-semibold text-gray-500 mt-1 block">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="story" class="py-20 bg-[#faf6ff] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-sunsetPeach">{story.eyebrow}</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-deepPurple mt-2 mb-4">{story.title}</h2>
        <p class="text-gray-600 text-base sm:text-lg">{story.intro}</p>
      </div>
      {story.chapters.map((chapter) => (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20 last:mb-0">
          <div class:list={['lg:col-span-5', chapter.reverse ? 'lg:order-2' : 'order-2 lg:order-1']}>
            <div class="relative rounded-3xl overflow-hidden shadow-xl border-4 border-white group">
              <img src={chapter.image.src} alt={chapter.imageAlt} class="w-full h-80 sm:h-96 object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-deepPurple/70 to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <span class="text-[10px] uppercase font-bold tracking-widest text-brand-sunsetPeach">{chapter.chapter}</span>
                <p class="font-serif font-bold text-lg">{chapter.caption}</p>
              </div>
            </div>
          </div>
          <div class:list={['lg:col-span-7 space-y-4', chapter.reverse ? 'lg:order-1' : 'order-1 lg:order-2']}>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-lavender text-brand-amethyst text-xs font-bold uppercase tracking-wider">{chapter.eyebrow}</div>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-brand-deepPurple">{chapter.title}</h3>
            {chapter.paragraphs.map((paragraph, index) => (
              <p class="text-gray-700 text-sm sm:text-base leading-relaxed">
                {chapter.chapter === 'Chapter 03' && index === 0 ? (
                  <>Today, Michelle is recognized internationally as a transformative spiritual mentor. Through her chart-topping podcast with over 750,000+ downloads, her private 1:1 VIP mentorship, and the <em>Manifesting Miracles Academy</em>, she has guided tens of thousands of souls out of survival terror and into magnetic certainty.</>
                ) : chapter.chapter === 'Chapter 02' && index === 2 ? (
                  <>Within months, radical shifts unfolded: financial abundance flowed effortlessly, relationships healed, and the channeled blueprints for what is now the <em>Manifesting Miracles™</em> movement began pouring in.</>
                ) : paragraph}
              </p>
            ))}
            {chapter.quote && (
              <div class="p-4 rounded-2xl bg-white border border-purple-100 flex items-start space-x-3 text-xs text-gray-600 italic">
                <i class="fa-solid fa-quote-left text-brand-sunsetPeach text-lg shrink-0 mt-0.5"></i>
                <span>"{chapter.quote}"</span>
              </div>
            )}
            {chapter.link && (
              <div class="pt-2">
                <a href={chapter.link.href} class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-brand-amethyst hover:text-brand-sunsetPeach transition-colors">{chapter.link.label}</a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-sunsetPeach">{pillars.eyebrow}</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-deepPurple mt-2 mb-3">{pillars.title}</h2>
        <p class="text-gray-600 text-sm sm:text-base">{pillars.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {pillars.items.map((item) => (
          <div class="glass-card p-6 sm:p-7 rounded-3xl border border-purple-100 shadow-sm hover:shadow-lg transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-brand-lavender text-brand-amethyst flex items-center justify-center text-xl mb-4 group-hover:scale-110 group-hover:bg-brand-sunsetPeach group-hover:text-white transition-all">
              <i class={item.icon}></i>
            </div>
            <span class="text-[10px] uppercase font-bold tracking-wider text-brand-sunsetPeach">{item.kicker}</span>
            <h3 class="font-serif font-bold text-lg text-brand-deepPurple mt-1 mb-2">{item.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="offerings" class="py-20 sunset-gradient relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-sunsetPeach">{offerings.eyebrow}</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-deepPurple mt-2 mb-4">{offerings.title}</h2>
        <p class="text-gray-700 text-base sm:text-lg">{offerings.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {offerings.cards.map((card) => (
          <div class:list={['rounded-3xl p-8 flex flex-col justify-between relative', card.featured ? 'spiritual-gradient border-2 border-brand-sunsetPeach text-white shadow-2xl transform md:-translate-y-2' : 'glass-card border border-white shadow-lg hover:-translate-y-1 transition-all duration-300']}>
            {card.ribbon && <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-sunsetPeach text-brand-deepPurple text-[10px] font-bold uppercase tracking-widest px-4 py-1 rounded-full shadow-sm">{card.ribbon}</div>}
            <div>
              <div class:list={['w-12 h-12 rounded-2xl flex items-center justify-center text-xl mb-6', card.featured ? 'bg-white/20 text-brand-gold' : 'bg-brand-lavender text-brand-amethyst']}>
                <i class={card.icon}></i>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-sunsetPeach">{card.eyebrow}</span>
              <h3 class:list={['font-serif text-2xl font-bold mt-1 mb-3', card.featured ? 'text-white' : 'text-brand-deepPurple']}>{card.title}</h3>
              <p class:list={['text-xs leading-relaxed mb-6', card.featured ? 'text-purple-100' : 'text-gray-600']}>{card.body}</p>
              <ul class:list={['space-y-2.5 text-xs mb-6', card.featured ? 'text-purple-200' : 'text-gray-700']}>
                {card.points.map((point) => (
                  <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand-sunsetPeach"></i> {point}</li>
                ))}
              </ul>
            </div>
            {card.href ? (
              <a href={card.href} class="block w-full py-3 text-center rounded-full text-xs font-bold uppercase tracking-wider bg-brand-deepPurple text-white hover:bg-brand-amethyst transition-colors shadow-sm">{card.cta}</a>
            ) : (
              <button type="button" data-open-booking data-program={card.program} class:list={['w-full py-3 text-center rounded-full text-xs font-bold uppercase tracking-wider transition-all', card.featured ? 'py-3.5 bg-gradient-to-r from-brand-sunsetPeach to-brand-warmRose text-brand-deepPurple hover:brightness-110 shadow-lg' : 'bg-brand-deepPurple text-white hover:bg-brand-amethyst shadow-sm']}>{card.cta}</button>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="praise" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-sunsetPeach">{praise.eyebrow}</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-deepPurple mt-2 mb-3">{praise.title}</h2>
        <div class="flex items-center justify-center gap-1 text-amber-400 text-sm">
          <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
          <span class="text-xs text-gray-600 font-semibold ml-2">{praise.rating}</span>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {praise.items.map((item) => (
          <div class="glass-card p-6 sm:p-8 rounded-3xl border border-purple-100 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex text-amber-400 text-xs mb-3">
                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
              </div>
              <h4 class="font-serif font-bold text-brand-deepPurple text-base mb-2">"{item.title}"</h4>
              <p class="text-xs text-gray-600 leading-relaxed italic">"{item.quote}"</p>
            </div>
            <div class="pt-6 border-t border-purple-100 mt-6 flex items-center space-x-3">
              <div class:list={['w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs', item.tone]}>{item.initials}</div>
              <div>
                <p class="text-xs font-bold text-brand-deepPurple">{item.name}</p>
                <p class="text-[10px] text-gray-500">{item.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#faf6ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="spiritual-gradient rounded-3xl p-8 sm:p-12 text-white shadow-2xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-xl text-center md:text-left">
          <span class="inline-block px-3 py-1 rounded-full bg-brand-sunsetPeach/20 text-brand-sunsetPeach text-xs font-bold tracking-wider uppercase">{aboutClose.eyebrow}</span>
          <h3 class="font-serif text-3xl sm:text-4xl font-bold leading-tight">{aboutClose.title}</h3>
          <p class="text-purple-100 text-sm leading-relaxed">{aboutClose.body}</p>
        </div>
        <a href={aboutClose.cta.href} class="px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-brand-sunsetPeach to-brand-warmRose text-brand-deepPurple hover:brightness-110 shadow-lg text-center transition-all">{aboutClose.cta.label}</a>
      </div>
    </div>
  </section>

  <div id="booking" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/70 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="aboutBookingTitle">
    <div class="glass-card max-w-md w-full rounded-3xl p-6 sm:p-8 border border-white/80 shadow-2xl relative text-left">
      <button type="button" data-close-booking class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 p-2" aria-label="Close">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
      <div class="text-center mb-6">
        <span class="inline-block p-3 rounded-full bg-brand-sunsetPeach/20 text-brand-sunsetPeach text-xl mb-2"><i class="fa-solid fa-sparkles"></i></span>
        <h3 id="aboutBookingTitle" class="font-serif text-2xl font-bold text-brand-deepPurple">{aboutBooking.title}</h3>
        <p class="text-xs text-gray-600 mt-1">{aboutBooking.intro}</p>
      </div>
      <div class="space-y-3.5">
        <p class="text-xs font-bold uppercase tracking-wider text-brand-sunsetPeach">Placeholder form</p>
        <label class="block text-xs font-semibold text-gray-700 mb-1" for="aboutInquiry">Inquiry Category</label>
        <select id="aboutInquiry" disabled class="w-full px-3.5 py-2.5 rounded-xl border border-purple-200 text-xs text-gray-700">
          {aboutBooking.programs.map((program) => <option value={program}>{program}</option>)}
        </select>
        <button type="button" disabled class="w-full py-3.5 rounded-full font-bold text-xs uppercase tracking-wider bg-brand-deepPurple text-white opacity-70 cursor-not-allowed">{aboutBooking.button}</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const modal = document.getElementById('booking');
  const select = document.getElementById('aboutInquiry');

  function openBooking(program?: string) {
    if (select instanceof HTMLSelectElement && program) select.value = program;
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function closeBooking() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  document.querySelectorAll('[data-open-booking], a[href="#booking"]').forEach((node) => {
    node.addEventListener('click', (event) => {
      event.preventDefault();
      const program = node.getAttribute('data-program') ?? 'Keynote Speaking';
      openBooking(program);
    });
  });

  document.querySelector('[data-close-booking]')?.addEventListener('click', closeBooking);
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeBooking();
  });
</script>
