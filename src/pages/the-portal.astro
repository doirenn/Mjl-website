---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmbedSlot from '../components/EmbedSlot.astro';
import { images } from '../data/images';
import {
  included,
  legal,
  plans,
  portalAnnouncement,
  portalApply,
  portalCtas,
  portalFooter,
  portalHero,
  portalIntro,
  portalSeo,
  sound,
  stages,
} from '../data/the-portal';
---

<BaseLayout title={portalSeo.title} description={portalSeo.description} ogImage={portalSeo.ogImage} ogAlt={portalSeo.ogAlt} announcement={portalAnnouncement} headerCtas={portalCtas} footer={portalFooter}>
  <section class="relative min-h-[70vh] flex items-end overflow-hidden">
    <img src={portalHero.image.src} alt={portalHero.image.alt} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-deepPurple via-brand-deepPurple/55 to-transparent"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4 py-20 text-white space-y-5">
      <p class="text-xs uppercase tracking-[0.25em] text-brand-sunsetPeach font-bold">{portalHero.kicker}</p>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold">{portalHero.title}</h1>
      <p class="text-lg text-purple-100 max-w-3xl">{portalHero.body}</p>
      <p class="text-sm text-purple-100">{portalHero.where}</p>
      <div class="flex flex-wrap gap-3">
        <a href="#apply" class="px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-sunsetPeach text-brand-deepPurple">Placeholder: claim your portal date</a>
        <a href="#expect" class="px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider border border-white/40">Explore The Full Sanctuary Flow</a>
      </div>
      <ul class="flex flex-wrap gap-4 text-xs font-semibold">{portalHero.proofs.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 space-y-4">
      <h2 class="font-serif text-4xl font-bold text-brand-deepPurple">{portalIntro.title}</h2>
      <p class="font-serif text-xl text-brand-amethyst">{portalIntro.subtitle}</p>
      {portalIntro.paragraphs.map((paragraph) => <p class="text-gray-700 leading-relaxed">{paragraph}</p>)}
      <div class="grid md:grid-cols-3 gap-4">
        {portalIntro.points.map((point) => (
          <div class="p-4 rounded-2xl bg-[#faf6ff] border border-purple-100">
            <h3 class="font-serif font-bold text-brand-deepPurple">{point.title}</h3>
            <p class="text-xs text-gray-600 mt-2">{point.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sunset-gradient">
    <div class="max-w-4xl mx-auto px-4 grid md:grid-cols-2 gap-8 items-center">
      <img src={sound.image.src} alt={sound.image.alt} class="rounded-3xl h-80 w-full object-cover border-4 border-white" />
      <div class="space-y-3">
        <p class="font-serif italic text-xl text-brand-amethyst">"{sound.quote}"</p>
        <h2 class="font-serif text-2xl font-bold text-brand-deepPurple">{sound.title}</h2>
        <p class="text-xs text-gray-600">{sound.meta}</p>
        <EmbedSlot label={sound.embedLabel} tone="light" />
        <p class="text-sm text-gray-700">"{sound.caption}"</p>
      </div>
    </div>
  </section>

  <section id="expect" class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-serif text-4xl font-bold text-brand-deepPurple mb-3">What to Expect</h2>
      <p class="text-gray-600 mb-8">Every hour inside The Portal is orchestrated to move your autonomic nervous system from vigilance and control into magnetic, sovereign receptivity.</p>
      <ol class="space-y-4">
        {stages.map((stage) => (
          <li class="glass-card p-5 rounded-2xl border border-purple-100">
            <p class="text-xs font-bold uppercase tracking-wider text-brand-sunsetPeach">{stage.stage}</p>
            <h3 class="font-serif text-xl font-bold text-brand-deepPurple">{stage.title}</h3>
            <p class="text-sm text-gray-600 mt-1">{stage.body}</p>
            {stage.points.length > 0 && (
              <ul class="mt-2 text-xs text-gray-600 list-disc pl-5">
                {stage.points.map((point) => <li>{point}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="included" class="py-20 bg-[#faf6ff]">
    <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-8 items-center">
      <img src={images.courseRichRegulated.src} alt="Private sanctuary from the sample" class="rounded-3xl h-96 w-full object-cover" />
      <div>
        <p class="font-serif italic text-xl text-brand-amethyst">"A consecrated space where your nervous system can finally exhale."</p>
        <h2 class="font-serif text-3xl font-bold text-brand-deepPurple mt-4">What's Included</h2>
        <p class="text-sm text-gray-600 mt-2">The Portal is not merely a single calendar day—it is a closed, multi-week continuum of preparation, physical immersion, and integration.</p>
        <ul class="mt-4 space-y-2 text-sm text-gray-700">
          {included.map((item) => <li class="flex gap-2"><i class="fa-solid fa-check text-brand-sunsetPeach mt-1"></i><span>{item}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white text-center">
    <h2 class="font-serif text-4xl font-bold text-brand-deepPurple">The Portal</h2>
    <p class="max-w-2xl mx-auto text-gray-600 mt-3">A day of intimacy and activation with Michelle. Step through the veil into your highest timeline. When you cease fighting circumstance and align your frequency with divine truth, the miracles that once felt impossible arrive as your baseline reality.</p>
  </section>

  <section id="pricing" class="py-20 sunset-gradient">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="font-serif text-4xl font-bold text-brand-deepPurple text-center">Investment & Payment Options</h2>
      <p class="text-center text-sm font-semibold text-brand-deepPurple my-4">Placeholder: no checkout is connected. These buttons do not take payment.</p>
      <div class="grid lg:grid-cols-3 gap-6">
        {plans.map((plan) => (
          <article class="glass-card rounded-3xl p-6 flex flex-col">
            <h3 class="font-serif text-2xl font-bold text-brand-deepPurple">{plan.name}</h3>
            <p class="font-serif text-4xl font-bold mt-2">{plan.price}</p>
            <p class="text-xs font-bold text-brand-sunsetPeach">{plan.detail}</p>
            <p class="text-sm text-gray-600 mt-3 flex-1">{plan.body}</p>
            {plan.bonus && <p class="text-xs font-semibold text-brand-amethyst mt-3">{plan.bonus}</p>}
            <a href="#apply" class="mt-6 block text-center py-3 rounded-full text-xs font-bold uppercase bg-brand-deepPurple text-white">{plan.cta}</a>
          </article>
        ))}
      </div>
      <ul class="mt-8 space-y-2 text-xs text-gray-700 max-w-3xl mx-auto">{legal.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section id="apply" class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 glass-card rounded-3xl p-8 border border-purple-100 space-y-4">
      <h2 class="font-serif text-3xl font-bold text-brand-deepPurple">{portalApply.title}</h2>
      <p class="text-sm text-gray-600">{portalApply.body}</p>
      <p class="text-xs font-semibold text-brand-sunsetPeach">{portalApply.note}</p>
      <select disabled class="w-full px-3 py-2 rounded-xl border text-xs">{portalApply.locations.map((item) => <option>{item}</option>)}</select>
      <select disabled class="w-full px-3 py-2 rounded-xl border text-xs">{portalApply.timing.map((item) => <option>{item}</option>)}</select>
      <select disabled class="w-full px-3 py-2 rounded-xl border text-xs">{portalApply.investments.map((item) => <option>{item}</option>)}</select>
      <button type="button" disabled class="w-full py-3 rounded-full text-xs font-bold uppercase bg-brand-deepPurple text-white opacity-70 cursor-not-allowed">{portalApply.button}</button>
      <p class="text-[11px] text-center text-gray-500">{portalApply.footnote}</p>
    </div>
  </section>

  <section class="py-16 bg-[#faf6ff]">
    <div class="max-w-5xl mx-auto px-4 spiritual-gradient rounded-3xl p-8 text-white flex flex-col md:flex-row justify-between gap-6 items-center">
      <div>
        <h2 class="font-serif text-3xl font-bold">Looking for Self-Guided Expansion?</h2>
        <p class="text-sm text-purple-100 mt-2">If an in-person portal day isn't aligned right now, step into the Manifesting Miracles Academy.</p>
      </div>
      <a href="/academy" class="px-8 py-4 rounded-full text-xs font-bold uppercase bg-brand-sunsetPeach text-brand-deepPurple">Join The Academy Today</a>
    </div>
  </section>
</BaseLayout>
