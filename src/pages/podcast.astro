---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmbedSlot from '../components/EmbedSlot.astro';
import {
  episodeFilters,
  episodes,
  featured,
  guestForm,
  host,
  listenerPraise,
  platforms,
  podcastAnnouncement,
  podcastClose,
  podcastCtas,
  podcastFooter,
  podcastHero,
  podcastSeo,
  quoteBand,
} from '../data/podcast';
---

<BaseLayout
  title={podcastSeo.title}
  description={podcastSeo.description}
  ogImage={podcastSeo.ogImage}
  ogAlt={podcastSeo.ogAlt}
  announcement={podcastAnnouncement}
  headerCtas={podcastCtas}
  footer={podcastFooter}
>
  <section class="relative pt-16 pb-24 overflow-hidden spiritual-gradient text-white">
    <div class="aurora-glow w-96 h-96 bg-brand-sunsetPeach/40 top-0 -left-10"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-semibold text-brand-sunsetPeach">
            <i class="fa-solid fa-podcast"></i>
            <span>{podcastHero.eyebrow}</span>
          </div>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.12] tracking-tight">
            {podcastHero.titleLead} <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-brand-sunsetPeach to-brand-gold">{podcastHero.titleAccent}</span> {podcastHero.titleTail}
          </h1>
          <p class="text-base sm:text-lg text-purple-100 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-light">
            Hosted by spiritual intuitive & manifestation mentor <strong>Michelle J. Lamont</strong>, this podcast offers weekly raw transmissions, neuro-spiritual blueprints, and deep soul alignments to release unconscious blocks and magnetize your destiny.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            <a href="#featured" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-brand-sunsetPeach to-brand-warmRose text-brand-deepPurple hover:brightness-110 shadow-xl transition-all">
              Latest episode slot
            </a>
            <a href="#episodes" class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 rounded-full text-xs font-bold uppercase tracking-wider text-white bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-md transition-all">
              View All 300+ Episodes
            </a>
          </div>
          <div class="grid grid-cols-3 gap-3 sm:gap-6 pt-6 max-w-lg mx-auto lg:mx-0">
            {podcastHero.stats.map((stat) => (
              <div class="glass-dark p-4 rounded-2xl border border-white/15 text-center">
                <span class="block font-serif text-2xl sm:text-3xl font-bold text-white">{stat.value}</span>
                <span class="text-[11px] uppercase tracking-wider text-purple-200 mt-1 block">{stat.label}</span>
              </div>
            ))}
          </div>
          <div class="pt-2">
            <p class="text-xs uppercase font-semibold text-purple-200 tracking-wider mb-3">Listen Free On Your Preferred Network:</p>
            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5">
              {platforms.map((platform) => (
                <a href="#placeholder" title={platform.label} class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/15 text-xs text-white transition-all">
                  <i class:list={[platform.icon, 'text-base', platform.iconClass]}></i> {platform.label}
                </a>
              ))}
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 relative flex justify-center">
          <div class="relative w-72 sm:w-88 max-w-full group">
            <div class="absolute -inset-4 bg-gradient-to-r from-brand-sunsetPeach to-brand-amethyst rounded-3xl blur-2xl opacity-50"></div>
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border-2 border-white/30 bg-[#1e0c33]">
              <div class="relative h-96 sm:h-[420px] overflow-hidden">
                <img src={podcastHero.cover.src} alt={podcastHero.cover.alt} class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-deepPurple via-brand-deepPurple/50 to-transparent"></div>
                <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center">
                  <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-2 border-brand-sunsetPeach p-1 mb-4 shadow-xl bg-white">
                    <img src={podcastHero.portrait.src} alt={podcastHero.portrait.alt} class="w-full h-full rounded-full object-cover" />
                  </div>
                  <p class="text-xs uppercase tracking-[0.3em] font-semibold text-brand-sunsetPeach">{podcastHero.showKicker}</p>
                  <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-1">{podcastHero.showTitle}</h2>
                  <p class="text-[11px] text-purple-200 mt-2 max-w-xs">{podcastHero.showLine}</p>
                </div>
              </div>
              <div class="p-4 bg-white/10 backdrop-blur-md border-t border-white/15">
                <p class="text-xs font-bold text-white">{podcastHero.latest}</p>
                <p class="text-[10px] text-purple-300">{podcastHero.latestMeta}</p>
                <div class="mt-3"><EmbedSlot label="Latest episode audio. No audio file is connected." /></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="featured" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-sunsetPeach">{featured.eyebrow}</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-deepPurple mt-2 mb-4">{featured.title}</h2>
        <p class="text-gray-600 text-base sm:text-lg">{featured.intro}</p>
      </div>
      <div class="glass-card rounded-3xl p-6 sm:p-10 lg:p-12 border border-purple-100 shadow-xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-6 space-y-4">
            <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-purple-200">
              <img src={featured.image.src} alt={featured.image.alt} class="w-full h-72 sm:h-96 object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-deepPurple/80 via-brand-amethyst/30 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                <span class="text-xs uppercase font-bold text-amber-300">{featured.milestone}</span>
                <h3 class="font-serif text-xl sm:text-2xl font-bold leading-tight">{featured.episodeTitle}</h3>
                <p class="text-xs mt-1">{featured.length}</p>
              </div>
            </div>
            <EmbedSlot label={featured.embedLabel} tone="light" />
          </div>
          <div class="lg:col-span-6 space-y-6">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-amethyst bg-brand-lavender px-3 py-1 rounded-full">{featured.outline}</span>
            <h3 class="font-serif text-2xl sm:text-3xl font-bold text-brand-deepPurple">{featured.headline}</h3>
            <p class="text-gray-600 text-sm sm:text-base leading-relaxed">{featured.body}</p>
            <div class="space-y-3">
              {featured.points.map((point) => (
                <div class="flex items-start space-x-3 text-sm text-gray-700">
                  <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs mt-0.5 shrink-0"><i class="fa-solid fa-check"></i></span>
                  <span><strong>{point.title}</strong> {point.text}</span>
                </div>
              ))}
            </div>
            <div class="bg-brand-softLilac p-4 rounded-2xl border border-purple-100">
              <p class="text-xs font-bold text-brand-amethyst uppercase tracking-wider mb-2">Key Timestamps:</p>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-gray-600">
                {featured.timestamps.map((stamp) => <li>{stamp}</li>)}
              </ul>
            </div>
            <a href="#placeholder" class="inline-flex px-6 py-3 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-deepPurple text-white">Placeholder: episode audio</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="episodes" class="py-20 bg-[#faf6ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-sunsetPeach">The Complete Library</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-deepPurple mt-2 mb-4">Explore Episodes by Intention</h2>
        <p class="text-gray-600 text-base sm:text-lg">Filter by topic or search specific questions to unlock the exact vibrational medicine you need today.</p>
        <p class="text-xs text-gray-500 mt-3">The sample lists these six episodes. A full archive of 300+ is not connected.</p>
      </div>
      <div class="max-w-3xl mx-auto mb-10 space-y-4">
        <input id="episodeSearch" type="search" placeholder="Search by topic, keyword (e.g. money, love, fear, spirit)..." class="w-full px-4 py-3.5 rounded-2xl glass-card border border-purple-200 text-sm" />
        <div class="flex flex-wrap items-center justify-center gap-2" data-episode-filters>
          {episodeFilters.map((filter, index) => (
            <button type="button" data-episode-filter={filter.id} class:list={['px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all', index === 0 ? 'bg-brand-deepPurple text-white' : 'bg-white text-gray-600 border border-purple-200']}>{filter.label}</button>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="episodesGrid">
        {episodes.map((episode) => (
          <article class="episode-card glass-card rounded-3xl overflow-hidden border border-purple-100 shadow-sm flex flex-col" data-category={episode.category} data-search={`${episode.title} ${episode.description} ${episode.category}`.toLowerCase()}>
            <div class="relative h-48 overflow-hidden">
              <img src={episode.image} alt="" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-deepPurple/70 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-white/90 text-brand-deepPurple">{episode.category}</span>
              <div class="absolute bottom-3 left-3 right-3 flex justify-between text-white text-xs">
                <span class="font-bold text-brand-sunsetPeach">Episode #{episode.id}</span>
                <span>{episode.duration}</span>
              </div>
            </div>
            <div class="p-6 space-y-2.5 flex-1">
              <span class="text-[11px] font-semibold text-gray-400 block">{episode.date}</span>
              <h3 class="font-serif text-lg font-bold text-brand-deepPurple">{episode.title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed">{episode.description}</p>
              <details class="text-xs text-gray-600">
                <summary class="cursor-pointer font-semibold text-brand-amethyst">Show notes</summary>
                <ul class="mt-2 space-y-1 list-disc pl-4">
                  {episode.takeaways.map((item) => <li>{item}</li>)}
                </ul>
              </details>
            </div>
          </article>
        ))}
      </div>
      <p id="episodeEmpty" class="hidden text-center py-12 font-serif text-lg font-bold text-brand-deepPurple">No episodes matched your query</p>
    </div>
  </section>

  <section class="relative py-24 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={quoteBand.background.src} alt={quoteBand.background.alt} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-brand-deepPurple/75"></div>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center space-y-6">
      <span class="inline-block px-3.5 py-1 rounded-full bg-white/20 text-brand-sunsetPeach text-xs font-bold uppercase tracking-widest">{quoteBand.eyebrow}</span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">"{quoteBand.quote}"</h2>
      <p class="text-purple-100 text-base sm:text-lg max-w-2xl mx-auto">{quoteBand.body}</p>
      <a href="#placeholder" class="inline-flex px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-sunsetPeach text-brand-deepPurple">Placeholder: subscribe</a>
    </div>
  </section>

  <section id="about-host" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 relative">
          <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white/90">
            <img src={host.image.src} alt={host.image.alt} class="w-full h-[480px] object-cover" />
          </div>
          <div class="absolute -bottom-6 -right-6 glass-card p-4 rounded-2xl shadow-xl max-w-xs text-left hidden sm:block">
            <p class="font-serif font-bold text-brand-deepPurple text-base">{host.cardTitle}</p>
            <p class="text-xs text-gray-600 mt-1">"{host.cardQuote}"</p>
          </div>
        </div>
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex px-3 py-1 rounded-full bg-brand-lavender text-brand-amethyst text-xs font-bold uppercase tracking-wider">{host.eyebrow}</div>
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-deepPurple">{host.name}</h2>
          <p class="text-xs uppercase tracking-[0.2em] font-bold text-brand-sunsetPeach">{host.role}</p>
          {host.paragraphs.map((paragraph, index) => (
            <p class="text-gray-700 text-sm sm:text-base leading-relaxed">
              {index === 1 ? <>On <em>Manifesting Miracles™</em>, Michelle pulls back the veil on commercial spiritual clichés, bringing hard-hitting neuro-spiritual practices and channeled insights directly to your headphones every single week.</> : paragraph}
            </p>
          ))}
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {host.badges.map((badge) => (
              <div class="p-3 rounded-xl bg-[#faf6ff] border border-purple-100">
                <span class="block font-bold text-brand-deepPurple text-sm">{badge.title}</span>
                <span class="text-[11px] text-gray-500">{badge.detail}</span>
              </div>
            ))}
          </div>
          <a href="/about" class="inline-flex px-6 py-3 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-deepPurple text-white">Full Biography & Story</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-[#faf6ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-sunsetPeach">{listenerPraise.eyebrow}</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-deepPurple mt-2 mb-3">{listenerPraise.title}</h2>
        <p class="text-xs text-gray-600 font-semibold">{listenerPraise.rating}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {listenerPraise.items.map((item) => (
          <div class="glass-card p-6 sm:p-8 rounded-3xl border border-purple-100 shadow-sm">
            <h4 class="font-serif font-bold text-brand-deepPurple text-base mb-2">"{item.title}"</h4>
            <p class="text-xs text-gray-600 leading-relaxed italic">"{item.quote}"</p>
            <div class="pt-6 mt-6 border-t border-purple-100 flex items-center gap-3">
              <div class:list={['w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs', item.tone]}>{item.initials}</div>
              <div>
                <p class="text-xs font-bold text-brand-deepPurple">{item.name}</p>
                <p class="text-[10px] text-gray-500">{item.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="text-center mt-10"><a href="#placeholder" class="text-xs font-bold uppercase tracking-wider text-brand-amethyst">Placeholder: Apple Podcasts review</a></p>
    </div>
  </section>

  <section id="guest-inquiry" class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <div class="glass-card rounded-3xl p-8 sm:p-12 border border-purple-200 shadow-xl space-y-4">
        <div class="text-center max-w-2xl mx-auto">
          <span class="inline-block px-3 py-1 rounded-full bg-brand-lavender text-brand-amethyst text-xs font-bold uppercase tracking-wider">{guestForm.eyebrow}</span>
          <h3 class="font-serif text-3xl font-bold text-brand-deepPurple mt-2">{guestForm.title}</h3>
          <p class="text-sm text-gray-600 mt-2">{guestForm.intro}</p>
          <p class="text-xs font-semibold text-brand-sunsetPeach mt-3">{guestForm.note}</p>
        </div>
        <label class="block text-xs font-semibold text-gray-700">Inquiry Type</label>
        <select disabled class="w-full px-4 py-3 rounded-xl border border-purple-200 text-xs">
          {guestForm.types.map((type) => <option>{type}</option>)}
        </select>
        <button type="button" disabled class="w-full py-3.5 rounded-full font-bold text-xs uppercase tracking-wider bg-brand-deepPurple text-white opacity-70 cursor-not-allowed">{guestForm.button}</button>
        <p class="text-[10px] text-center text-gray-500">{guestForm.footnote}</p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#faf6ff]">
    <div class="max-w-7xl mx-auto px-4">
      <div class="spiritual-gradient rounded-3xl p-8 sm:p-12 text-white flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-xl">
          <span class="inline-block px-3 py-1 rounded-full bg-brand-sunsetPeach/20 text-brand-sunsetPeach text-xs font-bold uppercase">{podcastClose.eyebrow}</span>
          <h3 class="font-serif text-3xl sm:text-4xl font-bold">{podcastClose.title}</h3>
          <p class="text-purple-100 text-sm">{podcastClose.body}</p>
        </div>
        <a href={podcastClose.cta.href} class="px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-brand-sunsetPeach to-brand-warmRose text-brand-deepPurple">{podcastClose.cta.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const search = document.getElementById('episodeSearch');
  let active = 'all';

  function applyEpisodeFilter() {
    const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
    let visible = 0;
    document.querySelectorAll('.episode-card').forEach((card) => {
      const category = card.getAttribute('data-category');
      const haystack = card.getAttribute('data-search') ?? '';
      const match = (active === 'all' || category === active) && haystack.includes(query);
      card.classList.toggle('hidden', !match);
      if (match) visible += 1;
    });
    document.getElementById('episodeEmpty')?.classList.toggle('hidden', visible !== 0);
  }

  search?.addEventListener('input', applyEpisodeFilter);
  document.querySelectorAll('[data-episode-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      active = button.getAttribute('data-episode-filter') ?? 'all';
      document.querySelectorAll('[data-episode-filter]').forEach((item) => {
        item.className = 'px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-white text-gray-600 border border-purple-200 transition-all';
      });
      button.className = 'px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-deepPurple text-white transition-all';
      applyEpisodeFilter();
    });
  });
</script>
