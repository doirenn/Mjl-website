---
import { curriculum } from '../data/goat';
---

<section class="border-b border-gold-500/20 bg-ivory py-20 text-ink sm:py-28" aria-labelledby="curriculum-title">
  <div class="shell">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-gold-ink">{curriculum.eyebrow}</p>
      <h2 id="curriculum-title" class="mt-3 font-serif text-4xl font-medium text-navy-950 sm:text-5xl">{curriculum.title}</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft sm:text-base">{curriculum.intro}</p>
    </div>

    <div class="mx-auto max-w-5xl space-y-4">
      {
        curriculum.chapters.map((chapter) => (
          <article class="flex flex-col justify-between gap-4 rounded-2xl border border-navy-800/10 bg-cream p-6 transition-colors hover:border-gold-500 sm:flex-row sm:items-center sm:p-8">
            <div class="flex items-start gap-5 sm:items-center">
              <p class="font-serif text-4xl italic text-gold-ink">{chapter.number}</p>
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold-ink">{chapter.label}</p>
                <h3 class="font-serif text-2xl font-medium text-navy-950 sm:text-3xl">{chapter.title}</h3>
              </div>
            </div>
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-ink-soft sm:max-w-[14rem] sm:text-right">{chapter.aside}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
