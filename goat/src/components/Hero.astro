---
import { hero } from '../data/goat';
import { imageIsReady } from '../lib/image';
import CtaLink from './CtaLink.astro';
import ImageSlot from './ImageSlot.astro';
import RichText from './RichText.astro';

const backgroundReady = imageIsReady(hero.background);
---

<section class="hero-wash relative overflow-hidden text-ivory" aria-labelledby="hero-title">
  {
    backgroundReady && (
      <img
        src={hero.background.src}
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-25"
        decoding="async"
      />
    )
  }
  <div class="relative z-10 py-16 sm:py-24 lg:py-28">
    <div class="shell grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="space-y-7 lg:col-span-7">
        <p class="inline-flex flex-wrap items-center gap-3 rounded-full border border-gold-300/40 bg-navy-950/50 px-4 py-1.5">
          <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-300">{hero.eyebrow}</span>
          <span class="text-gold-500" aria-hidden="true">|</span>
          <span class="text-[11px] font-medium uppercase tracking-[0.16em] text-ivory">{hero.season}</span>
        </p>

        <h1 id="hero-title" class="text-5xl font-medium leading-[1.02] tracking-tight text-ivory sm:text-6xl lg:text-7xl">
          {hero.titleLead}
          <span class="mt-1 block text-balance font-normal italic text-gold-300">{hero.titleAccent}</span>
        </h1>

        <RichText parts={hero.intro} surface="dark" class="max-w-2xl text-base leading-relaxed text-ivory sm:text-lg" />

        <p class="font-serif text-2xl italic text-gold-300 sm:text-3xl">{hero.tagline}</p>

        <div class="grid max-w-xl grid-cols-1 gap-3 pt-2 sm:grid-cols-3 sm:gap-4">
          {
            hero.moods.map((mood) => (
              <figure class="space-y-2">
                <ImageSlot image={mood.image} priority class="min-h-32 rounded-xl border border-gold-300/30 sm:aspect-[4/3] sm:min-h-0" />
                <figcaption class="text-[10px] font-medium uppercase tracking-[0.16em] text-gold-300 sm:text-xs">
                  {mood.caption}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="shadow-card rounded-2xl border border-gold-500/70 bg-ivory p-7 text-ink sm:p-9">
          <div class="mb-6 flex items-center justify-between gap-3 border-b border-gold-500/40 pb-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-gold-ink">{hero.cardKicker}</p>
            <p class="rounded-full border border-gold-500/50 bg-ivory-deep px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-navy-950">
              {hero.cardStatus}
            </p>
          </div>

          <h2 class="font-serif text-3xl font-medium leading-tight text-navy-950 sm:text-4xl">{hero.cardTitle}</h2>
          <p class="mt-4 text-sm leading-relaxed text-ink-soft">{hero.cardBody}</p>

          <div class="mt-6 space-y-3 rounded-xl border border-gold-500/60 bg-cream p-5">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-ink">{hero.priceLabel}</p>
                <p class="mt-1 flex flex-wrap items-baseline gap-2.5">
                  <span class="font-serif text-5xl font-medium text-navy-950">{hero.price}</span>
                  <span class="text-sm text-ink-soft line-through">{hero.priceAfter}</span>
                </p>
              </div>
              <p class="rounded-lg border border-gold-500/40 bg-ivory px-2.5 py-1 text-xs font-medium text-navy-950">
                {hero.priceWindow}
              </p>
            </div>
            <p class="border-t border-gold-500/40 pt-3 text-xs font-semibold text-navy-950">{hero.payFull}</p>
          </div>

          <div class="mt-6 flex items-start gap-3 rounded-xl border border-gold-500/50 bg-ivory-deep p-4">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path>
            </svg>
            <p class="text-xs leading-relaxed text-navy-950">
              <strong class="font-semibold uppercase tracking-wider text-gold-ink">{hero.bonusLabel}</strong>{' '}
              {hero.bonusBody}
            </p>
          </div>

          <CtaLink href={hero.checkoutUrl} class="mt-7 w-full">{hero.cta}</CtaLink>
          <p class="mt-4 text-center text-xs font-medium uppercase tracking-[0.14em] text-ink-soft">{hero.footnote}</p>
        </div>
      </div>
    </div>
  </div>
</section>
