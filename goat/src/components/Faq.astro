---
import { faq } from '../data/goat';
---

<section class="border-b border-gold-500/20 bg-cream py-20 text-ink sm:py-28" aria-labelledby="faq-title">
  <div class="shell">
    <div class="mb-14 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-gold-ink">{faq.eyebrow}</p>
      <h2 id="faq-title" class="mt-3 font-serif text-4xl font-medium text-navy-950 sm:text-5xl">{faq.title}</h2>
    </div>

    <div class="mx-auto max-w-4xl space-y-3.5">
      {
        faq.items.map((item, index) => (
          <details class="faq-item overflow-hidden rounded-2xl border border-navy-800/10 bg-ivory shadow-card" name="faq" open={index === 0}>
            <summary class="flex min-h-12 cursor-pointer items-center justify-between gap-4 px-6 py-5 sm:px-8">
              <span class="font-serif text-2xl font-medium text-navy-950">{item.question}</span>
              <span class="faq-plus text-2xl leading-none text-gold-ink" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="px-6 pb-6 text-sm leading-relaxed text-ink-soft sm:px-8 sm:text-base">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
