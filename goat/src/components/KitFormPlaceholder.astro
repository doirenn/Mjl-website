---
import { kitForm } from '../data/goat';
---

<section class="border-t border-gold-500/30 bg-ivory py-16 text-ink" aria-labelledby="kit-form-title">
  <div class="shell">
    <div class="mx-auto max-w-xl rounded-2xl border border-dashed border-gold-500 bg-cream p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-gold-ink">{kitForm.eyebrow}</p>
      <h2 id="kit-form-title" class="mt-2 font-serif text-3xl font-medium text-navy-950">{kitForm.title}</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-soft">{kitForm.body}</p>
      <form class="mt-6 space-y-4">
        <fieldset disabled class="space-y-4">
          <legend class="sr-only">{kitForm.title}</legend>
          <div>
            <label for="kit-name" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.16em] text-gold-ink">{kitForm.nameLabel}</label>
            <input id="kit-name" name="first_name" type="text" autocomplete="off" disabled class="min-h-12 w-full rounded-xl border border-navy-800/15 bg-ivory px-4 text-sm text-ink" />
          </div>
          <div>
            <label for="kit-email" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.16em] text-gold-ink">{kitForm.emailLabel}</label>
            <input id="kit-email" name="email" type="email" autocomplete="off" disabled class="min-h-12 w-full rounded-xl border border-navy-800/15 bg-ivory px-4 text-sm text-ink" />
          </div>
        </fieldset>
      </form>
    </div>
  </div>
</section>
