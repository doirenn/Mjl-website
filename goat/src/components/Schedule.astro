---
import { schedule } from '../data/goat';
import RichText from './RichText.astro';
---

<section class="border-b border-gold-500/20 bg-ivory-deep py-20 text-ink sm:py-28" aria-labelledby="schedule-title">
  <div class="shell">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-gold-ink">{schedule.eyebrow}</p>
      <h2 id="schedule-title" class="mt-3 font-serif text-4xl font-medium text-navy-950 sm:text-5xl">{schedule.title}</h2>
      <div class="mt-4 inline-block rounded-xl border border-gold-500/40 bg-ivory px-5 py-3.5 text-left text-sm text-navy-950 shadow-card sm:text-base">
        <RichText parts={schedule.timeNote} surface="light" />
      </div>
    </div>

    <div class="mx-auto max-w-5xl space-y-4">
      <article class="flex flex-col justify-between gap-3 rounded-2xl border-2 border-gold-500/50 bg-ivory p-6 shadow-card sm:flex-row sm:items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-ink">{schedule.kickoffLabel}</p>
          <h3 class="mt-0.5 font-serif text-2xl font-medium text-navy-950">{schedule.kickoffTitle}</h3>
        </div>
        <p class="self-start rounded-full border border-gold-500/40 bg-cream px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-navy-950 sm:self-center">
          {schedule.kickoffBadge}
        </p>
      </article>

      <div class="grid gap-4 md:grid-cols-3">
        {
          schedule.weeks.map((week) => (
            <article class="rounded-2xl border border-navy-800/10 bg-ivory p-6 shadow-card">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-ink">{week.label}</p>
              <p class="mt-2 font-serif text-lg font-medium text-navy-950">
                {week.lines[0]}
                <br />
                {week.lines[1]}
              </p>
              <p class="mt-2 text-xs font-medium text-ink-soft">{week.time}</p>
            </article>
          ))
        }
      </div>

      <article class="rounded-2xl border-2 border-gold-500/70 bg-ivory p-6 shadow-card sm:p-7">
        <div class="mb-2 flex flex-col justify-between gap-2 sm:flex-row sm:items-center">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-ink">{schedule.gateKicker}</p>
          <p class="text-xs font-semibold text-navy-950">{schedule.gateTime}</p>
        </div>
        <h3 class="font-serif text-2xl font-medium text-navy-950">
          {schedule.gateTitle.replace(schedule.gateEmphasis, '')}
          <span class="italic text-gold-ink">{schedule.gateEmphasis}</span>
        </h3>
        <p class="mt-2 text-sm text-ink-soft">{schedule.gateBody}</p>
      </article>

      <article class="rounded-2xl border border-navy-800/10 bg-ivory p-6 shadow-card sm:p-7">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-ink">{schedule.integrationKicker}</p>
        <h3 class="mt-1 font-serif text-2xl font-medium text-navy-950">{schedule.integrationTitle}</h3>
        <p class="mt-1.5 text-sm text-ink-soft">{schedule.integrationBody}</p>
      </article>

      <article class="rounded-2xl border-2 border-navy-800/20 bg-ivory p-6 shadow-card sm:p-7">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-ink">{schedule.comebackKicker}</p>
        <h3 class="mt-1 font-serif text-2xl font-medium text-navy-950">{schedule.comebackTitle}</h3>
        <p class="mt-1.5 text-sm text-ink-soft">{schedule.comebackBody}</p>
      </article>

      <div class="space-y-2 rounded-2xl border border-gold-500/50 bg-cream p-6 text-sm text-navy-950">
        {
          schedule.notes.map((note) => (
            <p>
              <strong class="text-gold-ink">{note.label}</strong>
              {note.text}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
