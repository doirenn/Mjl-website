---
import { finalCta } from '../data/goat';
import CtaLink from './CtaLink.astro';
---

<section class="bg-navy-950 py-24 text-ivory sm:py-32" aria-labelledby="final-cta-title">
  <div class="shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-gold-300">{finalCta.eyebrow}</p>
      <h2 id="final-cta-title" class="mt-4 font-serif text-4xl font-medium leading-tight text-ivory sm:text-6xl">{finalCta.title}</h2>

      <div class="mx-auto mt-8 max-w-2xl space-y-4 text-base leading-relaxed text-ivory sm:text-lg">
        <p>
          <strong class="text-gold-300">{finalCta.lead}</strong> {finalCta.presale}
        </p>
        <p>{finalCta.plans}</p>
        <p class="rounded-xl border border-gold-500 bg-ivory p-4 text-sm text-navy-950 sm:text-base">
          <strong class="uppercase tracking-wider text-gold-ink">{finalCta.bonusLabel}</strong>{' '}
          {finalCta.bonusBody}
        </p>
      </div>

      <figure class="mx-auto my-10 max-w-xl border-y border-ivory/25 py-5">
        <blockquote>
          <p class="font-serif text-2xl italic text-gold-300 sm:text-3xl">{finalCta.quote}</p>
        </blockquote>
        <figcaption class="mt-2 text-xs font-semibold uppercase tracking-[0.18em] text-gold-300">{finalCta.quoteName}</figcaption>
      </figure>

      <CtaLink href={finalCta.checkoutUrl} class="px-12">{finalCta.cta}</CtaLink>
      <p class="mt-6 text-xs font-medium uppercase tracking-[0.16em] text-ivory">{finalCta.refunds}</p>
    </div>
  </div>
</section>
